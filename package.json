{
  "name": "@resilientmq/core",
  "version": "3.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "description": "Core logic for resilient RabbitMQ event processing",
  "license": "MIT",
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "test": "jest --config test/jest.config.js --forceExit",
    "test:unit": "jest --config test/jest.config.unit.js --forceExit",
    "test:integration": "node test/scripts/run-integration-tests.js",
    "test:stress": "jest --config test/jest.config.stress.js --forceExit",
    "test:benchmark": "jest --config test/jest.config.benchmark.js --forceExit",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:stress",
    "test:coverage": "jest --config test/jest.config.unit.js --coverage --forceExit",
    "test:watch": "jest --config test/jest.config.unit.js --watch",
    "benchmark:report": "ts-node test/scripts/generate-benchmark-report.ts",
    "benchmark:compare": "node test/scripts/compare-benchmarks.js",
    "coverage:check": "node test/scripts/check-coverage.js",
    "quality:check": "npm run coverage:check && npm run benchmark:compare"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/resilientmq/core.git"
  },
  "bugs": {
    "url": "https://github.com/resilientmq/core/issues"
  },
  "homepage": "https://github.com/resilientmq/core#readme",
  "keywords": [
    "resilientmq",
    "rabbitmq",
    "amqp",
    "event",
    "messaging",
    "resilience",
    "typescript"
  ],
  "author": "resilientmq",
  "devDependencies": {
    "@testcontainers/rabbitmq": "^12.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "amqplib": "^2.0.1"
  },
  "overrides": {
    "undici": "^7.29.0",
    "lodash": "^4.18.1"
  }
}
